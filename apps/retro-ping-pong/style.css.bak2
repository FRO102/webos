:root {
  --accent: var(--os-accent, #ffffff);
  --bg: var(--os-bg, #000000);
  --fg: var(--os-fg, #ffffff);
  --muted: var(--os-muted, #9a9a9a);
  --surface: var(--os-surface, #111111);
  --shadow-md: 0 10px 28px rgba(0,0,0,0.3);
  --shadow-lg: 0 18px 40px rgba(0,0,0,0.35);
}
* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
body {
  display: grid;
  place-items: center;
  background: var(--bg);
  color: var(--fg);
  font: 14px/1.4 system-ui, sans-serif;
  overflow: hidden;
}
  body.compact { padding-top: 0; }\n.wrap {
  width: min(950px, 100vw - 16px);
  display: grid;
  gap: 10px;
}
#hud {
  display: grid;
  gap: 8px;
  padding: 10px;
  border-radius: 12px;
  background: var(--surface);
  border: 1px solid rgba(255,255,255,0.12);
  box-shadow: var(--shadow-md);
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 6px;
  border-radius: 9px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
}
.brand-mark {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: rgba(255,255,255,0.08);
  color: var(--accent);
  font: 800 12px monospace;
}
.brand-text { display: grid; line-height: 1.1; }
.brand-title { font-weight: 800; letter-spacing: .06em; }
.brand-tagline { font-size: 11px; color: var(--muted); }
.scoreboard {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 12px;
}
.player {
  display: grid;
  gap: 2px;
  text-align: center;
  padding: 6px 8px;
  border-radius: 9px;
  background: rgba(255,255,255,0.04);
}
.player.cpu { background: rgba(255,255,255,0.02); }
.label {
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--muted);
}
.value {
  font: 800 34px monospace;
  line-height: 1;
}
.sub {
  font-size: 11px;
  color: var(--muted);
  letter-spacing: .04em;
}
.meta { display: grid; gap: 2px; text-align: center; }
.versus { font: 800 20px monospace; color: var(--muted); letter-spacing: .08em; }
.row { font-weight: 600; letter-spacing: .06em; }
.row.small { font-size: 12px; color: var(--muted); }
.controls {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  justify-content: center;
}
#hud button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 10px;
  border-radius: 9px;
  border: 1px solid rgba(255,255,255,0.16);
  background: rgba(255,255,255,0.04);
  color: var(--fg);
  cursor: pointer;
  font: 500 12px/1.2 system-ui, sans-serif;
  transition: background .15s ease, transform .08s ease;
}
#hud button:hover { background: rgba(255,255,255,0.1); }
#hud button:active { transform: translateY(1px); }
#hud button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
#hud button.primary {
  background: var(--accent);
  color: #000;
  border-color: transparent;
  font-weight: 700;
}
.icon { width: 14px; height: 14px; }
#hud {
  transition: opacity .18s ease, transform .18s ease;
}
body.hud-hidden #hud {
  display: none;
}
body.hud-hidden .gear {
  position: fixed;
  bottom: 8px;
  right: 8px;
  z-index: 10;
}
.gear {
  padding: 6px 10px;
  border-radius: 9px;
  border: 1px solid rgba(255,255,255,0.16);
  background: rgba(255,255,255,0.04);
  color: var(--fg);
  cursor: pointer;
  font: 500 12px/1.2 system-ui, sans-serif;
}
.gear:hover { background: rgba(255,255,255,0.1); }
.gear:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.mini-hud {
  display: none;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 8px;
  border-radius: 9px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.15);
  color: var(--fg);
  font-size: 12px;
}
.wrap.compact .mini-hud {
  display: flex;
}
.wrap.compact header#hud {
  display: none;
}
.mini-controls {
  display: flex;
  gap: 4px;
}
.mini-controls button {
  width: 28px;
  height: 28px;
  padding: 0;
  border-radius: 7px;
  border: 1px solid rgba(255,255,255,0.16);
  background: rgba(255,255,255,0.04);
  color: var(--fg);
  cursor: pointer;
  font: 700 12px sans-serif;
}
.mini-controls button:hover { background: rgba(255,255,255,0.1); }
.options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  padding-top: 8px;
  border-top: 1px dashed rgba(255,255,255,.18);
}
.options.hidden { display: none; }
.field { display: grid; gap: 4px; }
.field label {
  font-size: 11px;
  color: var(--muted);
  letter-spacing: .08em;
  text-transform: uppercase;
  font-weight: 600;
}
.segmented {
  display: inline-flex;
  padding: 4px;
  border-radius: 9px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.15);
  gap: 4px;
}
.seg {
  padding: 6px 12px;
  border-radius: 7px;
  border: 0;
  background: transparent;
  color: var(--fg);
  cursor: pointer;
  font: 600 12px system-ui, sans-serif;
}
.seg:hover { background: rgba(255,255,255,0.1); }
.seg.active { background: var(--accent); color: #000; }
.seg:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
.stepper {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 6px;
  border-radius: 9px;
  border: 1px solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.04);
}
.stepper button {
  width: 28px;
  height: 28px;
  padding: 0;
  border-radius: 7px;
  font: 700 14px sans-serif;
}
#target-value {
  min-width: 24px;
  text-align: center;
  font: 700 16px monospace;
}
.switch {
  position: relative;
  width: 46px;
  height: 26px;
  padding: 0;
  border-radius: 999px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  cursor: pointer;
}
.switch .knob {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--muted);
  transition: transform .15s ease, background .15s ease;
}
.switch[aria-checked="true"] { background: var(--accent); }
.switch[aria-checked="true"] .knob {
  transform: translateX(20px);
  background: #000;
}
.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding-top: 2px;
}
.status {
  font-size: 12px;
  color: var(--muted);
  min-height: 1.3em;
}
.record-badge {
  padding: 4px 8px;
  border-radius: 999px;
  background: var(--accent);
  color: #000;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .04em;
}
.record-badge.hidden { display: none; }
.game-shell {
  width: min(950px, 100vw - 16px);
}
.arena {
  position: relative;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 8px;
  align-items: center;
}
.arena-rail {
  width: 58px;
  text-align: center;
  padding: 6px 4px;
  border-radius: 9px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.12);
}
.rail-label {
  font-size: 10px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 700;
}
.rail-score {
  font: 800 26px monospace;
  line-height: 1.1;
}
.canvas-stage {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid rgba(255,255,255,0.18);
  box-shadow: var(--shadow-lg);
  touch-action: none;
}
.canvas-stage::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: repeating-linear-gradient(0deg, rgba(255,255,255,0.06), rgba(255,255,255,0.06) 1px, transparent 1px, transparent 3px);
}
canvas {
  display: block;
  width: 100%;
  height: auto;
  background: var(--bg);
}
.overlay {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  background: rgba(0,0,0,0.82);
  backdrop-filter: blur(3px);
}
.overlay.hidden { display: none; }
.overlay-card {
  width: min(420px, calc(100% - 24px));
  background: var(--surface);
  border: 1px solid rgba(255,255,255,0.22);
  border-radius: 12px;
  padding: 16px;
  text-align: center;
  display: grid;
  gap: 8px;
  box-shadow: 0 18px 40px rgba(0,0,0,0.45);
}
.overlay-title { margin: 0; font-size: 22px; letter-spacing: .1em; }
.overlay-text { margin: 0; color: var(--muted); font-size: 13px; }
.cta.primary {
  width: 100%;
  padding: 8px 12px;
  font-weight: 700;
}
.help-list {
  list-style: none;
  margin: 6px 0 0;
  padding: 0;
  display: grid;
  gap: 6px;
  text-align: left;
}
.help-list li {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 8px;
  align-items: center;
  font-size: 12px;
}
.help-list kbd {
  font: 600 11px monospace;
  padding: 2px 6px;
  border-radius: 6px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
}
.hints {
  text-align: center;
  color: var(--muted);
  font-size: 12px;
  margin: 0;
}
.value.pop { animation: score-pop .24s cubic-bezier(.18,.89,.32,1.28); transform-origin: center; }
.rail-score.pop { animation: rail-pop .35s cubic-bezier(.2,.8,.4,1.3); }
@keyframes score-pop { 0% { transform: scale(1); } 40% { transform: scale(1.25); } 100% { transform: scale(1); } }
@keyframes rail-pop { 0% { transform: scale(1); } 40% { transform: scale(1.15); filter: brightness(1.3); } 100% { transform: scale(1); } }
@media (max-width: 900px) {
  .arena { grid-template-columns: 1fr; }
  .arena-rail { display: flex; align-items: center; justify-content: center; gap: 8px; }
  .rail-label { margin-right: 4px; }
}
@media (max-width: 720px) {
  .scoreboard { grid-template-columns: 1fr 1fr; }
  .meta { order: 3; grid-column: 1 / -1; }
  .options { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  * { transition: none; animation: none; }
  .canvas-stage::after { display: none; }
}